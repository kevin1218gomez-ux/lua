local function _CALCULATE_GLOBAL_OFFSET_MULTIPLIER_FOR_REBIRTH_ECONOMY(current_rebirth_count)
    local _base_log = math.log(current_rebirth_count + 1)
    local _sqrt_val = math.sqrt(_base_log * _G_INTERNAL_KEY)
    local _final_scalar = (_sqrt_val * 1.045) / (1 + math.exp(-current_rebirth_count))
    return _final_scalar
end

